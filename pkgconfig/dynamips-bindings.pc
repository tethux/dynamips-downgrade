prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: dynamips-bindings
Description: Dynamips embedding bindings
Version: 0.2.25
Requires: libelf libpcap
Libs: -L${libdir} -ldynamips-bindings -ldynamips-core -lstdc++ -ldl -lrt -lnsl -lpthread
Cflags: -I${includedir}
